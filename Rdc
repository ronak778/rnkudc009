local function isFriend(plr)
    if not friendProtectionEnabled or not plr or plr == lp then return false end
    local ok, r = pcall(function() return lp:IsFriendsWith(plr.UserId) end)
    return ok and r
end

local function isWhitelisted(plr)
    if not plr or plr == lp then return false end
    local lname = plr.Name:lower()
    for _, name in ipairs(whitelist) do
        if lname == name then return true end
    end
    if not friendlyFireEnabled and isFriend(plr) then return true end
    return false
end

local function isEnemy(player)
    if player == lp then return false end
    if isWhitelisted(player) then return false end
    local teams = game:GetService("Teams"):GetTeams()
    if #teams > 1 then
        if lp.Team == nil or player.Team == nil then return true end
        return lp.Team ~= player.Team
    end
    return true
end

