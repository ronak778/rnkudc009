    local function lineHeight(a, b, p)
        local ab = Vector3.new(b.X - a.X, 0, b.Z - a.Z)
        local len2 = ab:Dot(ab)
        if len2 < 1e-6 then return b.Y end
        local t = math.clamp(Vector3.new(p.X - a.X, 0, p.Z - a.Z):Dot(ab) / len2, 0, 1)
        return a.Y + (b.Y - a.Y) * t
    end

    local function timeToFloor(h, vy, g)
        if g <= 0 then return 0 end
        local disc = vy * vy + 2 * g * math.max(h, 0)
        return math.max(0, (vy + math.sqrt(disc)) / g)
    end

