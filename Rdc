local function addWhitelist(name)
    name = (name or ""):lower():gsub("^%s+", ""):gsub("%s+$", ""):gsub("@", "")
    if #name == 0 then return false end
    for _, n in ipairs(whitelist) do if n == name then return false end end
    table.insert(whitelist, name); return true
end

local function removeWhitelist(name)
    name = (name or ""):lower()
    for i, n in ipairs(whitelist) do
        if n == name then table.remove(whitelist, i); return true end
    end
    return false
end

