-- ═══════════ SURPRISE LOOP ═══════════
local function engage(myRoot, tRoot)
    if not (myRoot and tRoot) then return end
    local behind = tRoot.CFrame.LookVector * -3.5
    local standPos = tRoot.Position + behind + Vector3.new(0, 3, 0)
    myRoot.CFrame = CFrame.lookAt(standPos, tRoot.Position)
end

local function fireSurpriseHit(cfg, tChar, tRoot)
    if not (tChar and tRoot) then return end
    local pos, cf = tRoot.Position, tRoot.CFrame
    if BadgeRE then pcall(function() BadgeRE:FireServer({ HitChars={tChar}, HITBOX_CFRAME=cf }) end) end
    if FXRE and cfg and cfg.fxAction then pcall(function() FXRE:FireServer({ EndPoint=pos, action=cfg.fxAction, Origin=pos }) end) end
    if HitFXRE then pcall(function() HitFXRE:FireServer(pos) end) end
end

local function maintainGodMode(force)
    if not SpawnerRE then return end
    local elapsed = tick() - spawnerState.lastFire
    if force or elapsed >= spawnerState.nextWait then
        pcall(function() SpawnerRE:FireServer() end)
        spawnerState.lastFire = tick()
        spawnerState.nextWait = avRnd(AV.SPAWNER_MIN, AV.SPAWNER_MAX)
    end
end

local surpriseToken = 0

local function runSurpriseIteration(token, myRoot, myHum)
    local tChar = ghostTarget and ghostTarget.Character
    local tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")
    local tHum  = tChar and tChar:FindFirstChildOfClass("Humanoid")
    if not (tRoot and tHum and tHum.Health > 0) then
        if isWhitelisted(ghostTarget) then ghostTarget=nil; victimLocked=false end
        avJitter(AV.DEAD_POLL_MIN, AV.DEAD_POLL_MAX); return
    end
    engage(myRoot, tRoot); avJitter(AV.REPOSITION_MIN, AV.REPOSITION_MAX)
    local hits = math.random(AV.HITS_MIN, AV.HITS_MAX)
    for i = 1, hits do
        if not (surpriseOn and token == surpriseToken) then break end
        if isWhitelisted(ghostTarget) then ghostTarget=nil; victimLocked=false; break end
        tChar = ghostTarget and ghostTarget.Character
        tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")
        if not (tRoot and tChar) then break end
        
        -- Removed distance limit, always hits
        engage(myRoot, tRoot); avJitter(AV.REPOSITION_MIN, AV.REPOSITION_MAX)
        tChar = ghostTarget and ghostTarget.Character
        tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")
        if not tRoot then break end
        
        myRoot.CFrame = CFrame.lookAt(myRoot.Position, tRoot.Position)
        fireSurpriseHit(nil, tChar, tRoot)
        if FlingRE then pcall(function() FlingRE:FireServer(ghostTarget) end) end
        if i < hits then avJitter(AV.HIT_GAP_MIN, AV.HIT_GAP_MAX) end
    end
    maintainGodMode(false); avJitter(AV.CYCLE_YIELD_MIN, AV.CYCLE_YIELD_MAX)
end

local function startSurpriseLoop()
    surpriseToken += 1
    local token = surpriseToken
    spawnerState.lastFire = 0; spawnerState.nextWait = 0
    task.spawn(function()
        while surpriseOn and token == surpriseToken do
            if not FlingRE then findRemotes() end
            local myChar = lp.Character; local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
            local myHum  = myChar and myChar:FindFirstChildOfClass("Humanoid")
            if not (myRoot and myHum) then avJitter(AV.DEAD_POLL_MIN, AV.DEAD_POLL_MAX); continue end
            runSurpriseIteration(token, myRoot, myHum)
        end
    end)
end

