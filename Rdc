    local function doChallenge(name)
        if snowlandRunning then return end
        snowlandRunning = true
        local progressTarget = (name == "Tricks") and TRICKS_GOAL or 36800

        for attempt = 1, 4 do
            snowSetStatus(name .. " — attempt " .. attempt .. "/4")
            local char, hrp, hum = snowGetChar()
            if not (hrp and hum) then task.wait(3) continue end

            local pad, why = findPad(name)
            if not pad then
                snowSetStatus(name .. " — " .. why)
                task.wait(4)
                continue
            end
            local padPos = pad:IsA("BasePart") and pad.Position or pad:GetPivot().Position
            hrp.CFrame = CFrame.new(padPos + Vector3.new(0, 4, 0))
            task.wait(3)

            local started = waitUntil(function() return char:GetAttribute("InHut") ~= true end, 15)
            if not started then task.wait(4) continue end

            snowSetStatus(name .. " — racing! InHut=" .. tostring(char:GetAttribute("InHut")))
            local idx = 1
            local done = false
            local died = false
            local conns = {}
            local startTime = tick()

            conns[1] = RunService.Heartbeat:Connect(function()
                if hum and hum.Parent then hum.Health = hum.MaxHealth end
            end)
            conns[2] = hum.Died:Connect(function() died = true end)

            task.spawn(function()
                while not done and not died do
                    pcall(rProgress.FireServer, rProgress, math.clamp((idx - 1) / (#nodes - 1), 0, 1) * progressTarget)
                    task.wait(0.5)
                end
            end)

            local airborne, stunts, stuntVia, lastKick = false, 0, "-", 0
            local airWindow, airLeft = 0, 0
            local score = nil
            local startPos = hrp.Position

            if name == "Tricks" then
                conns[3] = RunService.Heartbeat:Connect(function()
                    if done or died or not hrp.Parent then return end
                    hrp.AssemblyAngularVelocity = airborne and Vector3.new(0, 30, 0) or Vector3.zero
                end)
                task.spawn(function()
                    local keys, via = resolveTrickKeys()
                    local summary = {}
                    for _, tn in ipairs(SPAM_TRICKS) do
                        table.insert(summary, tn .. "=" .. (keys[tn] and keys[tn].Name or ("none: " .. via[tn])))
                    end
                    stuntVia = table.concat(summary, " ")
                    local doneWindow, spamIdx = 0, 0
                    local function stop() return done or died or airLeft < RELEASE_MARGIN end
                    while not done and not died do
                        if airborne and airWindow ~= doneWindow then
                            doneWindow = airWindow
                            while airborne and airLeft >= START_MIN_AIR and not (done or died) do
                                spamIdx = spamIdx % #SPAM_TRICKS + 1
                                local tn = SPAM_TRICKS[spamIdx]
                                if keys[tn] then
                                    local hold = math.min(SPAM_HOLD, math.max(airLeft - RELEASE_MARGIN, 0.05))
                                    stuntVia = tn .. ":" .. (pressKey(keys[tn], hold, stop) and keys[tn].Name or "FAILED")
                                    stunts = stunts + 1
                                end
                                task.wait(SPAM_INTERVAL)
                            end
                        end
                        task.wait(0.03)
                    end
                end)
                task.spawn(function()
                    local lbl = findScoreLabel()
                    while not done and not died do
                        if lbl and lbl.Parent then
                            local v = readScore(lbl)
                            if v then score = v end
                        else
                            lbl = findScoreLabel()
                        end
                        task.wait(0.25)
                    end
                end)
            end

            local rayParams = RaycastParams.new()
            rayParams.FilterType = Enum.RaycastFilterType.Exclude
            rayParams.FilterDescendantsInstances = {char}
            rayParams.CollisionGroup = hrp.CollisionGroup
            local rayHit = false

            conns[4] = RunService.Stepped:Connect(function()
                if done or died or not hrp or not hrp.Parent then return end
                if idx > #nodes then done = true return end

                local target = nodes[idx]
                local diff = target - hrp.Position
                local flat = Vector3.new(diff.X, 0, diff.Z)

                if flat.Magnitude < 30 then
                    idx = idx + 1
                    return
                end

                local dir = flat.Unit
                local speed = (name == "Tricks") and TRICKS_SPEED or RUN_SPEED
                hrp.AssemblyLinearVelocity = dir * speed + Vector3.new(0, hrp.AssemblyLinearVelocity.Y, 0)

                if not (name == "Tricks" and airborne) then
                    hrp.CFrame = CFrame.lookAt(hrp.Position, hrp.Position + dir)
                end

                local p = hrp.Position
                local ray = workspace:Raycast(p + Vector3.new(0, RAY_UP, 0), Vector3.new(0, -RAY_LEN, 0), rayParams)
                rayHit = ray ~= nil
                local floorY, slack
                if ray then
                    floorY, slack = ray.Position.Y + HOVER, 0
                else
                    floorY, slack = lineHeight(idx > 1 and nodes[idx - 1] or startPos, target, p), LINE_SLACK
                end

                if p.Y < floorY - slack then
                    local v = hrp.AssemblyLinearVelocity
                    hrp.CFrame = CFrame.new(p.X, floorY, p.Z) * (hrp.CFrame - hrp.CFrame.Position)
                    hrp.AssemblyLinearVelocity = Vector3.new(v.X, 0, v.Z)
                    p = hrp.Position
                end
                local wasAirborne = airborne
                airborne = (p.Y - floorY) > AIR_CLEARANCE
                if airborne and not wasAirborne then airWindow = airWindow + 1 end

                if name == "Tricks" and not airborne and tick() - lastKick > JUMP_EVERY then
                    lastKick = tick()
                    local v = hrp.AssemblyLinearVelocity
                    hrp.AssemblyLinearVelocity = Vector3.new(v.X, JUMP_VY, v.Z)
                end
                airLeft = airborne and timeToFloor(p.Y - floorY, hrp.AssemblyLinearVelocity.Y, workspace.Gravity) or 0
            end)

            local deadline = startTime + ((name == "Tricks") and RUN_DEADLINE_TRICKS or RUN_DEADLINE)
            while not done and not died do
                if not hrp.Parent or tick() > deadline then died = true end
                if hrp.Parent then
                    local line2
                    if name == "Tricks" then
                        line2 = string.format("a=%s p=%d sc=%s/%d %s", airborne and "Y" or "n", stunts, score and tostring(score) or "?", TRICKS_GOAL, stuntVia)
                    else
                        local long = "-"
                        if not rayHit then
                            local r = workspace:Raycast(hrp.Position + Vector3.new(0, RAY_UP, 0), Vector3.new(0, -1000, 0), rayParams)
                            long = r and (r.Instance.Name .. "@" .. math.floor(hrp.Position.Y + RAY_UP - r.Position.Y)) or "none"
                        end
                        line2 = string.format("grp=%s vy=%.0f long=%s", hrp.CollisionGroup, hrp.AssemblyLinearVelocity.Y, long)
                    end
                    snowSetStatus(string.format("%s n%d/%d y=%.0f ray=%s\n%s", name, idx, #nodes, hrp.Position.Y, rayHit and "hit" or "MISS", line2))
                end
                task.wait(0.5)
            end

            for _, c in conns do if c then pcall(c.Disconnect, c) end end

            if done then
                local elapsed = tick() - startTime
                snowSetStatus(name .. " COMPLETE! Time: " .. math.floor(elapsed) .. "s")
                notify("Snowland", name .. " done!")
                task.wait(2)

                local runFinished = ReplicatedStorage:FindFirstChild("RunFinished")
                if runFinished then
                    for i = 1, 5 do
                        pcall(function() runFinished:FireServer(math.floor(elapsed), 1, progressTarget, nil) end)
                        task.wait(0.2)
                    end
                else
                    snowSetStatus(name .. " — RunFinished not found")
                end

                task.wait(10)
                break
            else
                snowSetStatus(name .. " — died/timeout, retrying")
                task.wait(5)
            end
        end
        snowlandRunning = false
        snowSetStatus("ready")
    end

    addButtonRow(surprisePage, "☠ SNOWLAND: TIME", function() doChallenge("Time") end)
    addButtonRow(surprisePage, "☠ SNOWLAND: TRICKS", function() doChallenge("Tricks") end)
    addButtonRow(surprisePage, "☠ SNOWLAND: MINO", function() doChallenge("Mino") end)
    addButtonRow(surprisePage, "☠ SNOWLAND: RUN ALL", function()
        if snowlandRunning then return end
        task.spawn(function()
            for _, ch in ipairs({ "Time", "Mino", "Tricks" }) do doChallenge(ch) end
            notify("DONE", "All 3 cleared!")
        end)
    end)
else
