        end
        return nil, 'no pad with Challenge == "' .. name .. '"'
    end

    local function matchesTrick(s, trick)
        s = s:lower()
        return s == trick or s:find(trick, 1, true) ~= nil
    end

    local function resolveTrickKeys()
        local keys, via = {}, {}
        local okB, bound = pcall(function() return ContextActionService:GetAllBoundActionInfo() end)
        if not (okB and type(bound) == "table") then bound = nil end
        local names = {}
        if bound then
            for action in pairs(bound) do table.insert(names, action) end
            table.sort(names)
        end
        for _, trick in ipairs(SPAM_TRICKS) do
            via[trick] = "no binding"
            if KEY_OVERRIDE[trick] then
                keys[trick], via[trick] = KEY_OVERRIDE[trick], "override"
            elseif bound then
                local best
                for _, action in ipairs(names) do
                    local a = action:lower()
                    if a == trick then best = action break end
                    if not best and matchesTrick(a, trick) then best = action end
                end
                if best then
                    via[trick] = best .. " has no KeyCode"
                    for _, it in ipairs(bound[best].inputTypes or {}) do
                        if typeof(it) == "EnumItem" and it.EnumType == Enum.KeyCode then
                            keys[trick], via[trick] = it, best
                            break
                        end
                    end
                end
            end
        end
        return keys, via
    end

