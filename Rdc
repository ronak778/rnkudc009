    if not autoVictim or not keyVerified or noMercyTargetOn then
        if lp.Character then local h = lp.Character:FindFirstChildOfClass("Humanoid")
            if h then lastHealth = h.Health end end; return
    end
    
    local myChar = lp.Character; local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
    if not myHum then return end
    local cur = myHum.Health; local drop = lastHealth - cur
    if drop >= AV.MIN_DAMAGE then
        local hpPct = cur / math.max(myHum.MaxHealth, 1)
        local lockedValid = false
        if victimLocked and ghostTarget and ghostTarget.Character and not isWhitelisted(ghostTarget) then
            local r = ghostTarget.Character:FindFirstChild("HumanoidRootPart")
            local h = ghostTarget.Character:FindFirstChildOfClass("Humanoid")
            if r and h and h.Health > 0 then lockedValid=true; ATK.last=ghostTarget; ATK.time=tick() end
        end
        if not lockedValid then
            local attacker = resolveAttacker()
            if attacker then 
                lockAttacker(attacker) 
            else
                surpriseOn = false
                ghostTarget = nil
                victimLocked = false
                updateAvPanelVictim(nil)
            end
        end
    end
    lastHealth = cur
end)

